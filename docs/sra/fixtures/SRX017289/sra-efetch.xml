ab_name="" accession="SRA012156"><IDENTIFIERS><PRIMARY_ID>SRA012156</PRIMARY_ID><SUBMITTER_ID namespace="GEO">GEO: GSE18729</SUBMITTER_ID></IDENTIFIERS></SUBMISSION><Organization type="center"><Name abbr="GEO">Gene Expression Omnibus</Name></Organization><STUDY center_name="GEO" alias="GSE18729" accession="SRP002056"><IDENTIFIERS><PRIMARY_ID>SRP002056</PRIMARY_ID><EXTERNAL_ID namespace="BioProject" label="primary">PRJNA123835</EXTERNAL_ID><EXTERNAL_ID namespace="GEO">GSE18729</EXTERNAL_ID></IDENTIFIERS><DESCRIPTOR><STUDY_TITLE>High throughput sequencing of endogenous small RNAs from AGO pathway mutants</STUDY_TITLE><STUDY_TYPE existing_study_type="Transcriptome Analysis"/><STUDY_ABSTRACT>High-throughput pyrosequencing of endogenous small RNAs from &gt;95% male enriched populations of alg-3(tm1155);alg-4(ok1041);fog-2(q71) and fog-2(q71) worms as well as purified spermatids from fem-3(q20) adult worms. Gametogenesis is thermosensitive in numerous metazoa ranging from worms to man.  In C. elegans a variety of germ-line nuage- (P-granule) -associated RNA-binding proteins including the Piwi-clade Argonaute, PRG-1, have been implicated in temperature-dependent fertility.  Here, we describe the role of two AGO-class paralogs, alg-3 (T22B3.2) and alg-4 (ZK757.3) in promoting male fertility at elevated temperatures.  A rescuing GFP::alg-3 transgene is localized in P-granules beginning at the late pachytene stage of male gametogenesis. alg-3/4 double mutants lack a subgroup of small RNAs, named 26G-RNAs, which target and appear to down-regulate numerous spermatogenesis-expressed mRNAs. These findings add to a growing number of AGO pathways required for temperature-dependent fertility in C. elegans and support a model in which AGOs and their small RNA co-factors function to promote robustness in gene-expression networks. Overall design: 3 samples examined. Small RNAs from alg-3(tm1155);alg-4(ok1041);fog-2(q71) males and fog-2(q71) males.   Small RNAs from spermatids isolated from ferm-3(q20) worms.</STUDY_ABSTRACT><CENTER_PROJECT_NAME>GSE18729</CENTER_PROJECT_NAME></DESCRIPTOR><STUDY_LINKS><STUDY_LINK><XREF_LINK><DB>pubmed</DB><ID>20133686</ID></XREF_LINK></STUDY_LINK></STUDY_LINKS><STUDY_ATTRIBUTES><STUDY_ATTRIBUTE><TAG>parent_bioproject</TAG><VALUE>PRJNA121635</VALUE></STUDY_ATTRIBUTE></STUDY_ATTRIBUTES></STUDY><SAMPLE alias="GSM465245" accession="SRS011830"><IDENTIFIERS><PRIMARY_ID>SRS011830</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN00009557</EXTERNAL_ID><EXTERNAL_ID namespace="GEO" label="Sample name">GSM465245</EXTERNAL_ID></IDENTIFIERS><TITLE>small RNAs_wild type (fog-2)_adult males_part1</TITLE><SAMPLE_NAME><TAXON_ID>6239</TAXON_ID><SCIENTIFIC_NAME>Caenorhabditis elegans</SCIENTIFIC_NAME></SAMPLE_NAME><SAMPLE_LINKS><SAMPLE_LINK><XREF_LINK><DB>bioproject</DB><ID>123835</ID><LABEL>PRJNA123835</LABEL></XREF_LINK></SAMPLE_LINK><SAMPLE_LINK><XREF_LINK><DB>bioproject</DB><ID>121635</ID><LABEL>PRJNA121635</LABEL></XREF_LINK></SAMPLE_LINK></SAMPLE_LINKS><SAMPLE_ATTRIBUTES><SAMPLE_ATTRIBUTE><TAG>source_name</TAG><VALUE>wild type adult males</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>strain</TAG><VALUE>Wild type, fog-2(q71)</VALUE></SAMPLE_ATTRIBUTE></SAMPLE_ATTRIBUTES></SAMPLE><Pool><Member member_name="" accession="SRS011830" sample_name="GSM465245" sample_title="small RNAs_wild type (fog-2)_adult males_part1" spots="1068858" bases="38478888" tax_id="6239" organism="Caenorhabditis elegans"><IDENTIFIERS><PRIMARY_ID>SRS011830</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN00009557</EXTERNAL_ID><EXTERNAL_ID namespace="GEO" label="Sample name">GSM465245</EXTERNAL_ID></IDENTIFIERS></Member></Pool><RUN_SET runs="1" bases="38478888" spots="1068858" bytes="18011637"><RUN alias="GSM465245_1" center_name="GEO" accession="SRR037073" total_spots="1068858" total_bases="38478888" size="18011637" load_done="true" published="2010-03-05 17:31:32" is_public="true" cluster_name="public" has_taxanalysis="1" static_data_available="1"><IDEN