{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:meta-standards-converter:miniml-package:2.0",
  "title": "MSC MINiML 2.0 package",
  "type": "object",
  "required": ["miniml_schema_version", "source", "database", "organization", "contributor", "platform", "sample", "series"],
  "properties": {
    "miniml_schema_version": {"const": "2.0"},
    "source": {"$ref": "#/$defs/sourceInfo"},
    "database": {"type": "array", "items": {"$ref": "#/$defs/openRecord"}},
    "organization": {"type": "array", "items": {"$ref": "#/$defs/openRecord"}},
    "contributor": {"type": "array", "items": {"$ref": "#/$defs/contributor"}},
    "platform": {"type": "array", "items": {"$ref": "#/$defs/openRecord"}},
    "sample": {"type": "array", "items": {"$ref": "#/$defs/sample"}},
    "series": {"$ref": "#/$defs/series"},
    "extensions": {"$ref": "#/$defs/extensions"}
  },
  "additionalProperties": false,
  "$defs": {
    "scalar": {"type": ["string", "number", "boolean"]},
    "openRecord": {"type": "object"},
    "extensions": {"type": "object"},
    "sourceDocument": {
      "type": "object",
      "required": ["kind", "name"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "uri": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"},
        "media_type": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "sourceInfo": {
      "type": "object",
      "required": ["format"],
      "properties": {
        "format": {"type": "string", "minLength": 1},
        "version": {"type": "string"},
        "schema_location": {"type": "string"},
        "documents": {"type": "array", "items": {"$ref": "#/$defs/sourceDocument"}}
      },
      "additionalProperties": false
    },
    "annotation": {
      "type": "object",
      "required": ["field", "value"],
      "properties": {
        "field": {"type": "string", "minLength": 1},
        "value": {"type": "string", "minLength": 1},
        "term_source_ref": {"type": "string"},
        "term_accession_number": {"type": "string"},
        "hierarchy_depth": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "comment": {
      "type": "object",
      "required": ["name", "value"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "value": {"$ref": "#/$defs/scalar"}
      },
      "additionalProperties": false
    },
    "ontologyValue": {
      "type": "object",
      "required": ["value"],
      "properties": {
        "value": {"type": "string"},
        "term_source_ref": {"type": "string"},
        "term_accession_number": {"type": "string"},
        "annotations": {"type": "array", "items": {"$ref": "#/$defs/annotation"}}
      },
      "additionalProperties": false
    },
    "organism": {
      "type": "object",
      "required": ["value"],
      "properties": {
        "value": {"type": "string"},
        "taxid": {"type": "string"},
        "annotations": {"type": "array", "items": {"$ref": "#/$defs/annotation"}}
      },
      "additionalProperties": true
    },
    "namedValue": {
      "type": "object",
      "required": ["name", "value"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "value": {"$ref": "#/$defs/scalar"},
        "term_source_ref": {"type": "string"},
        "term_accession_number": {"type": "string"},
        "unit": {"$ref": "#/$defs/ontologyValue"},
        "annotations": {"type": "array", "items": {"$ref": "#/$defs/annotation"}},
        "comments": {"type": "array", "items": {"$ref": "#/$defs/comment"}},
        "qualifier": {"type": "string"},
        "unit_type": {"type": "string"}
      },
      "additionalProperties": false
    },
    "contributor": {
      "type": "object",
      "properties": {
        "iid": {"type": "string"},
        "person": {"$ref": "#/$defs/openRecord"},
        "organization": {"type": "string"},
        "company": {"type": "string"},
        "email": {"type": "string"},
        "phone": {"type": "string"},
        "fax": {"type": "string"},
        "laboratory": {"type": "string"},
        "department": {"type": "string"},
        "address": {},
        "organization_ref": {"$ref": "#/$defs/openRecord"},
        "web_link": {"type": "string"},
        "roles": {"type": "array", "items": {"$ref": "#/$defs/ontologyValue"}},
        "extensions": {"$ref": "#/$defs/extensions"}
      },
      "additionalProperties": false
    },
    "channel": {
      "type": "object",
      "properties": {
        "source": {"$ref": "#/$defs/ontologyValue"},
        "organism": {"type": "array", "items": {"$ref": "#/$defs/organism"}},
        "characteristics": {"type": "array", "items": {"$ref": "#/$defs/namedValue"}},
        "biomaterial_provider": {"type": "array"},
        "treatment_protocol": {"type": "string"},
        "growth_protocol": {"type": "string"},
        "molecule": {"$ref": "#/$defs/ontologyValue"},
        "extract_protocol": {"type": "string"},
        "label": {"type": "string"},
        "label_protocol": {"type": "string"},
        "annotations": {"type": "array", "items": {"$ref": "#/$defs/annotation"}},
        "extensions": {"$ref": "#/$defs/extensions"}
      },
      "additionalProperties": false
    },
    "sample": {
      "type": "object",
      "properties": {
        "iid": {"type": "string"},
        "accession": {"type": "array"},
        "status": {"type": "array"},
        "title": {"type": "string"},
        "type": {"type": "string"},
        "channel_count": {"type": "string"},
        "channel": {"type": "array", "items": {"$ref": "#/$defs/channel"}},
        "platform_ref": {"$ref": "#/$defs/openRecord"},
        "contact_ref": {"type": "array"},
        "description": {"type": "string"},
        "instrument_model": {},
        "library_strategy": {"type": "string"},
        "library_source": {"type": "string"},
        "library_selection": {"type": "string"},
        "data_processing": {"type": "string"},
        "raw_data": {"type": "array"},
        "supplementary_data": {"type": "array"},
        "relation": {"type": "array"},
        "data_table": {"$ref": "#/$defs/openRecord"},
        "sra_accession": {"type": "array", "items": {"type": "string"}},
        "ena_accession": {"type": "array", "items": {"type": "string"}},
        "sra_run": {"type": "array"}
      },
      "additionalProperties": true
    },
    "protocol": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "type": {"$ref": "#/$defs/ontologyValue"},
        "description": {"type": "string"},
        "parameters": {"type": "array", "items": {"type": "string"}},
        "hardware": {"type": "array", "items": {"type": "string"}},
        "software": {"type": "array", "items": {"type": "string"}},
        "contacts": {"type": "array", "items": {"type": "string"}},
        "performers": {"type": "array", "items": {"type": "string"}},
        "comments": {"type": "array", "items": {"$ref": "#/$defs/comment"}}
      },
      "additionalProperties": false
    },
    "variable": {
      "type": "object",
      "properties": {
        "factor": {"type": "string"},
        "type": {"$ref": "#/$defs/ontologyValue"},
        "description": {"type": "string"},
        "sample_ref": {"type": "array", "items": {"$ref": "#/$defs/openRecord"}},
        "position": {"type": "string"}
      },
      "additionalProperties": true
    },
    "protocolApplication": {
      "type": "object",
      "required": ["kind", "protocol_ref"],
      "properties": {
        "kind": {"const": "protocol_application"},
        "protocol_ref": {"type": "string", "minLength": 1},
        "parameter_values": {"type": "array", "items": {"$ref": "#/$defs/namedValue"}},
        "performer": {"type": "string"},
        "date": {"type": "string"},
        "comments": {"type": "array", "items": {"$ref": "#/$defs/comment"}},
        "extensions": false
      },
      "additionalProperties": false
    },
    "assayNode": {
      "type": "object",
      "required": ["kind", "name"],
      "properties": {
        "kind": {"enum": ["source", "sample", "extract", "labeled_extract", "hybridization", "assay", "scan", "normalization", "array_data_file", "derived_array_data_file", "array_data_matrix_file", "derived_array_data_matrix_file", "image_file"]},
        "name": {"type": "string", "minLength": 1},
        "sample_ref": {"type": "string"},
        "characteristics": {"type": "array", "items": {"$ref": "#/$defs/namedValue"}},
        "factor_values": {"type": "array", "items": {"$ref": "#/$defs/namedValue"}},
        "provider": {"type": "string"},
        "material_type": {"$ref": "#/$defs/ontologyValue"},
        "description": {"type": "string"},
        "label": {"$ref": "#/$defs/ontologyValue"},
        "technology_type": {"$ref": "#/$defs/ontologyValue"},
        "array_design_ref": {"$ref": "#/$defs/openRecord"},
        "link": {},
        "comments": {"type": "array", "items": {"$ref": "#/$defs/comment"}},
        "extensions": false
      },
      "additionalProperties": false
    },
    "assayPath": {
      "type": "object",
      "required": ["steps"],
      "properties": {
        "document": {"type": "string"},
        "steps": {"type": "array", "items": {"oneOf": [{"$ref": "#/$defs/assayNode"}, {"$ref": "#/$defs/protocolApplication"}]}},
        "comments": {"type": "array", "items": {"$ref": "#/$defs/comment"}}
      },
      "additionalProperties": false
    },
    "series": {
      "type": "object",
      "anyOf": [{"required": ["iid"]}, {"required": ["accession"]}],
      "properties": {
        "iid": {"type": "string"},
        "accession": {"type": "array"},
        "status": {"type": "array"},
        "title": {"type": "string"},
        "pubmed_id": {"type": "array"},
        "pubmed_publication": {"type": "array"},
        "citation": {"type": "array"},
        "web_link": {"type": "array"},
        "summary": {"type": "string"},
        "overall_design": {"type": "string"},
        "experiment_date": {"type": "string"},
        "type": {"type": "array", "items": {"$ref": "#/$defs/ontologyValue"}},
        "contributor_ref": {"type": "array", "items": {"$ref": "#/$defs/openRecord"}},
        "contributor": {"type": "array", "items": {"$ref": "#/$defs/contributor"}},
        "contact_ref": {"type": "array", "items": {"$ref": "#/$defs/openRecord"}},
        "contact": {"type": "array", "items": {"$ref": "#/$defs/contributor"}},
        "sample_ref": {"type": "array"},
        "variable": {"type": "array", "items": {"$ref": "#/$defs/variable"}},
        "repeats": {"type": "array"},
        "supplementary_data": {"type": "array"},
        "relation": {"type": "array"},
        "data_table": {"type": "array"},
        "protocols": {"type": "array", "items": {"$ref": "#/$defs/protocol"}},
        "assay_paths": {"type": "array", "items": {"$ref": "#/$defs/assayPath"}},
        "quality_controls": {"type": "array", "items": {"$ref": "#/$defs/ontologyValue"}},
        "replicate_types": {"type": "array", "items": {"$ref": "#/$defs/ontologyValue"}},
        "normalization_types": {"type": "array", "items": {"$ref": "#/$defs/ontologyValue"}},
        "comments": {"type": "array", "items": {"$ref": "#/$defs/comment"}},
        "declarations": {"$ref": "#/$defs/extensions"},
        "extensions": {"$ref": "#/$defs/extensions"}
      },
      "additionalProperties": false
    }
  }
}
